# Copy this file to .env.local and fill in your own free API keys.
# NEVER commit .env.local, and never use a NEXT_PUBLIC_ prefix for keys.

# Google Gemini API — free key from Google AI Studio: https://aistudio.google.com/
# Free tier (Nov 2026): gemini-3.5-flash-lite ~500 requests/day, no card required.
GEMINI_API_KEY=

# Groq — free key from the Groq console: https://console.groq.com/keys
# Free tier (Nov 2026): 30 RPM, 1,000 requests/day, 8,000 TPM per model, no card required.
GROQ_API_KEY=

# OpenRouter — free key from https://openrouter.ai/keys
# Free tier (Nov 2026): :free models at 20 RPM, 50 requests/day (1,000/day after a
# one-time $10 purchase). No card required for the 50/day tier.
OPENROUTER_API_KEY=

# Mistral (La Plateforme) — free key from https://console.mistral.ai/api-keys
# Free mode: no card required (phone verification), rate caps are per-account and
# unpublished — check Admin Panel > API > Limits.
MISTRAL_API_KEY=
